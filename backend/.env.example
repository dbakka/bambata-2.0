# BAMBATA 2.0 Backend Configuration

# Gemini API Key (for LLM Arrangement Reasoning Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key (for track retention recommendations)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Modal Serverless GPU Configuration (Optional if running local DSP simulation)
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & Temp Directories
STORAGE_DIR=./storage
TEMP_DIR=./storage/temp
RENDERS_DIR=./storage/renders
PREVIEWS_DIR=./storage/previews
